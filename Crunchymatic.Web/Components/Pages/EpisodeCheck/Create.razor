@page "/anime/{AnimeId:int}/add-check"
@using Crunchymatic.Web.Models
@using Crunchymatic.Web.Services
@using Microsoft.EntityFrameworkCore
@using NodaTime
@inject IDbContextFactory<CrunchymaticContext> DbFactory
@inject NavigationManager Navigation
@inject SubtitleStorageService SubtitleStorage
@inject SubtitleUploadReportStore SubtitleUploadReports
@inject ILogger<Create> Logger

@if (Anime == null)
{
    <PageTitle>Some anime</PageTitle>
}
else
{
    <PageTitle>New check for @Anime.EnglishTitle</PageTitle>
}

@if (Anime == null)
{
    <p aria-busy="true">Loading anime…</p>
    return;
}

<AnimeHeader Anime="Anime"/>
<h5>Creating a new episode check entry for <b>@Anime.EnglishTitle</b>.</h5>

<EditForm Model="Model" OnValidSubmit="OnValidEpisodeCheckCreationFormSubmit" FormName="CreateEpisodeCheck" enctype="multipart/form-data">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    <EpisodeCheckForm Model="Model"/>
    <SubtitleUploadForm SubtitleFilesName="@nameof(SubtitleFiles)"/>
    <button type="submit">Create</button>
</EditForm>

@code
{
    [Parameter] public int AnimeId { get; set; }

    private Anime? Anime { get; set; }

    // this doesn't work if put into Model from what I can tell
    [SupplyParameterFromForm] public IFormFileCollection SubtitleFiles { get; set; } = null!;
    
    [SupplyParameterFromForm] private EpisodeCheckForm.EpisodeCheckDTO Model { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if (Model == null!)
        {
            Model = new EpisodeCheckForm.EpisodeCheckDTO();
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var anime = await context.Anime.FirstOrDefaultAsync(x => x.Id == AnimeId);

        if (anime == null)
        {
            Navigation.NotFound();
            return;
        }

        Anime = anime;
    }

    private async Task OnValidEpisodeCheckCreationFormSubmit()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var episodeCheck = new EpisodeCheck()
        {
            AnimeId = AnimeId,
            CrunchyrollEpisodeId = Model.CrunchyrollEpisodeId,
            EpisodeReleased = Instant.FromDateTimeOffset(Model.EpisodeReleased),
            Episode = Model.Episode,
            AudioLanguage = Model.AudioLanguage,
            TimeSubtitlesGrabbed = Instant.FromDateTimeOffset(Model.TimeSubtitlesGrabbed)
        };

        context.EpisodeChecks.Add(episodeCheck);

        IReadOnlyList<SubtitleUploadResult> results = SubtitleFiles is { Count: > 0 }
            ? await SubtitleStorage.StoreFilesAsync(SubtitleFiles, episodeCheck)
            : [];

        await context.SaveChangesAsync();

        foreach (var result in results)
        {
            Logger.LogInformation("file {file} {status} as {lang}", result.FileName, result.Status, result.LanguageCode);
        }

        var editUrl = $"/check/{episodeCheck.Id}/edit";
        
        if (results.Any(x => !x.Succeeded))
        {
            editUrl = $"{editUrl}?upload={SubtitleUploadReports.Stash(results)}";
        }

        Navigation.NavigateTo(editUrl);
    }
}
